<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="160dp"
            android:height="160dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            
            <!-- 1. Background Circle Badge (Solid Anchor, Perfect Circle, Never Scales/Jumps) -->
            <group
                android:name="circle_group"
                android:pivotX="54"
                android:pivotY="54">
                <path
                    android:name="bg_circle"
                    android:fillColor="#3875E0"
                    android:pathData="M 54,0 A 54,54 0 1,0 54,108 A 54,54 0 1,0 54,0 Z" />
            </group>
            
            <!-- 2. Rear Card Group (Material 3 Soft Azure #A2C8F8) -->
            <group
                android:name="rear_group"
                android:pivotX="58"
                android:pivotY="47">
                <path
                    android:name="rear_card"
                    android:fillColor="#A2C8F8"
                    android:pathData="M 50,29 H 66 C 73.732,29 80,35.268 80,43 V 51 C 80,58.732 73.732,65 66,65 H 50 C 42.268,65 36,58.732 36,51 V 43 C 36,35.268 42.268,29 50,29 Z" />
            </group>
            
            <!-- 3. Front Bubble & Post Bars Group -->
            <group
                android:name="front_group"
                android:pivotX="52"
                android:pivotY="55">
                
                <!-- Front Dialogue Bubble (Crisp White #FFFFFF) -->
                <path
                    android:name="front_bubble"
                    android:fillColor="#FFFFFF"
                    android:pathData="M 46,34 H 62 C 69.732,34 76,40.268 76,48 V 56 C 76,63.732 69.732,70 62,70 H 44 C 37.0,70.0 31.0,73.0 28.5,75.5 C 26.8,76.5 26.0,74.0 28.0,71.5 C 30.5,68.0 32.0,61.0 32.0,48.0 C 32.0,40.268 38.268,34.0 46.0,34.0 Z" />
                
                <!-- Top Post Bar (Cobalt Blue #2D68D6) -->
                <group
                    android:name="top_bar_group"
                    android:pivotX="55"
                    android:pivotY="46.75">
                    <path
                        android:name="top_bar"
                        android:fillColor="#2D68D6"
                        android:pathData="M 45.25,43.5 H 64.75 C 66.545,43.5 68,44.955 68,46.75 C 68,48.545 66.545,50 64.75,50 H 45.25 C 43.455,50 42,48.545 42,46.75 C 42,44.955 43.455,43.5 45.25,43.5 Z" />
                </group>
                
                <!-- Bottom Post Bar (Cobalt Blue #2D68D6) -->
                <group
                    android:name="bot_bar_group"
                    android:pivotX="50.5"
                    android:pivotY="57.75">
                    <path
                        android:name="bot_bar"
                        android:fillColor="#2D68D6"
                        android:pathData="M 45.25,54.5 H 55.75 C 57.545,54.5 59,55.955 59,57.75 C 59,59.545 57.545,61 55.75,61 H 45.25 C 43.455,61 42,59.545 42,57.75 C 42,55.955 43.455,54.5 45.25,54.5 Z" />
                </group>
            </group>
            
            <group android:name="time_marker" />
        </vector>
    </aapt:attr>
    
    <!-- 1. Rear Card Elastic Rise & Isotropic Scale (0ms - 420ms) -->
    <target android:name="rear_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="420"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.75"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="420"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.75"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="420"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="translateY"
                    android:valueFrom="10.0"
                    android:valueTo="0.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="rear_card">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="180"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    
    <!-- 2. Front Bubble Elastic Pop & Settle Tilt (60ms - 920ms) -->
    <target android:name="front_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <!-- Elastic Scale Entrance -->
                <objectAnimator
                    android:startOffset="60"
                    android:duration="320"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.65"
                    android:valueTo="1.05"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="380"
                    android:duration="140"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="1.05"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="60"
                    android:duration="320"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.65"
                    android:valueTo="1.05"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="380"
                    android:duration="140"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="1.05"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                    
                <!-- Translate Y Float Up -->
                <objectAnimator
                    android:startOffset="60"
                    android:duration="400"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="translateY"
                    android:valueFrom="12.0"
                    android:valueTo="0.0"
                    android:valueType="floatType" />
                    
                <!-- Expressive Micro-Tilt (560ms - 880ms) -->
                <objectAnimator
                    android:startOffset="560"
                    android:duration="160"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:valueFrom="0.0"
                    android:valueTo="-2.5"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="720"
                    android:duration="160"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:valueFrom="-2.5"
                    android:valueTo="0.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="front_bubble">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="60"
                    android:duration="180"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    
    <!-- 3. Top Post Bar Isotropic Scale (Preserves Rounded Capsule Corners) -->
    <target android:name="top_bar_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="260"
                    android:duration="240"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.5"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="260"
                    android:duration="240"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.5"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="top_bar">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="260"
                    android:duration="140"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    
    <!-- 4. Bottom Post Bar Isotropic Scale (Preserves Rounded Capsule Corners) -->
    <target android:name="bot_bar_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="340"
                    android:duration="240"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.5"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="340"
                    android:duration="240"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.5"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="bot_bar">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="340"
                    android:duration="140"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    
    <!-- 5. Total Timing Sentinel (1000ms duration) -->
    <target android:name="time_marker">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="1000"
                    android:propertyName="translateX"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
