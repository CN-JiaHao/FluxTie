<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="432dp"
            android:height="432dp"
            android:viewportWidth="432"
            android:viewportHeight="432">
            
            <!-- Background Circle -->
            <group
                android:name="circle_group"
                android:pivotX="216"
                android:pivotY="216">
                <path
                    android:name="bg_circle"
                    android:fillColor="#3875E0"
                    android:pathData="M 216,24 A 192,192 0 1,0 216,408 A 192,192 0 1,0 216,24 Z" />
            </group>
            
            <!-- Rear Card Group -->
            <group
                android:name="rear_group"
                android:pivotX="232"
                android:pivotY="188">
                <path
                    android:name="rear_card"
                    android:fillColor="#A2C8F8"
                    android:pathData="M 200,116 H 264 C 294.93,116 320,141.07 320,172 V 204 C 320,234.93 294.93,260 264,260 H 200 C 169.07,260 144,234.93 144,204 V 172 C 144,141.07 169.07,116 200,116 Z" />
            </group>
            
            <!-- Front Bubble & Content Group -->
            <group
                android:name="front_group"
                android:pivotX="216"
                android:pivotY="208">
                
                <!-- Front Bubble Body (Crisp White) -->
                <path
                    android:name="front_bubble"
                    android:fillColor="#FFFFFF"
                    android:pathData="M 184,136 H 248 C 278.93,136 304,161.07 304,192 V 224 C 304,254.93 278.93,280 248,280 H 176 C 148,280 124,292 114,302 C 107.2,306 104,296 112,286 C 122,272 128,244 128,192 C 128,161.07 153.07,136 184,136 Z" />
                
                <!-- Top Post Bar (Cobalt Blue #2D68D6) -->
                <group
                    android:name="top_bar_group"
                    android:pivotX="168"
                    android:pivotY="187">
                    <path
                        android:name="top_bar"
                        android:fillColor="#2D68D6"
                        android:pathData="M 181,174 H 259 C 266.18,174 272,179.82 272,187 C 272,194.18 266.18,200 259,200 H 181 C 173.82,200 168,194.18 168,187 C 168,179.82 173.82,174 181,174 Z" />
                </group>
                
                <!-- Bottom Post Bar (Cobalt Blue #2D68D6) -->
                <group
                    android:name="bot_bar_group"
                    android:pivotX="168"
                    android:pivotY="231">
                    <path
                        android:name="bot_bar"
                        android:fillColor="#2D68D6"
                        android:pathData="M 181,218 H 223 C 230.18,218 236,223.82 236,231 C 236,238.18 230.18,244 223,244 H 181 C 173.82,244 168,238.18 168,231 C 168,223.82 173.82,218 181,218 Z" />
                </group>
            </group>
            
            <group android:name="time_marker" />
        </vector>
    </aapt:attr>
    
    <!-- 1. Circle Scale & Bloom Animation (0 - 450ms) -->
    <target android:name="circle_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="450"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.72"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="450"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.72"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="bg_circle">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="220"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    
    <!-- 2. Rear Card Elastic Rise & Scale (60ms - 520ms) -->
    <target android:name="rear_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="60"
                    android:duration="460"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.60"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="60"
                    android:duration="460"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.60"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="60"
                    android:duration="460"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="translateY"
                    android:valueFrom="36.0"
                    android:valueTo="0.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="rear_card">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="60"
                    android:duration="200"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    
    <!-- 3. Front Bubble Elastic Pop & Settle Tilt (120ms - 950ms) -->
    <target android:name="front_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <!-- Elastic Scale Entrance -->
                <objectAnimator
                    android:startOffset="120"
                    android:duration="320"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.55"
                    android:valueTo="1.06"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="440"
                    android:duration="160"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="1.06"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="120"
                    android:duration="320"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.55"
                    android:valueTo="1.06"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="440"
                    android:duration="160"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="1.06"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                    
                <!-- Translate Y Float Up -->
                <objectAnimator
                    android:startOffset="120"
                    android:duration="420"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="translateY"
                    android:valueFrom="44.0"
                    android:valueTo="0.0"
                    android:valueType="floatType" />
                    
                <!-- Expressive Micro-Tilt (600ms - 920ms) -->
                <objectAnimator
                    android:startOffset="600"
                    android:duration="160"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:valueFrom="0.0"
                    android:valueTo="-3.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="760"
                    android:duration="160"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:valueFrom="-3.0"
                    android:valueTo="0.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="front_bubble">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="120"
                    android:duration="220"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    
    <!-- 4. Top Post Bar Stream Expansion (320ms - 560ms) -->
    <target android:name="top_bar_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="320"
                    android:duration="240"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="top_bar">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="320"
                    android:duration="140"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    
    <!-- 5. Bottom Post Bar Stream Expansion (420ms - 660ms) -->
    <target android:name="bot_bar_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="420"
                    android:duration="240"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="bot_bar">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="420"
                    android:duration="140"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    
    <!-- 6. Total Timing Sentinel (1000ms duration) -->
    <target android:name="time_marker">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="1000"
                    android:propertyName="translateX"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
